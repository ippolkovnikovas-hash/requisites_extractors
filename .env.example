# LLM Provider: ollama | openai | mock
LLM_PROVIDER=ollama

# Ollama settings (если LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenAI settings (если LLM_PROVIDER=openai)
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Prompt version
PROMPT_VERSION=v1

# LLM timeout in seconds
LLM_TIMEOUT_SECONDS=120.0

# Tesseract path (Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Flask settings
FLASK_SECRET_KEY=change_me_in_production
FLASK_DEBUG=false
# OCR: tesseract | easyocr; доп. проходы OCR для поиска чисел (медленнее, точнее на фото)
OCR_BACKEND=tesseract
OCR_EXTRA_PASSES=true

# LibreOffice для .doc (пусто = автопоиск soffice)
LIBREOFFICE_PATH=
