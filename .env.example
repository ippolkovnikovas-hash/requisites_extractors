# LLM Provider: ollama | openai | yandex | mock
LLM_PROVIDER=ollama

# Ollama settings (если LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenAI settings (если LLM_PROVIDER=openai)
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Prompt version: v1 — для локальных моделей; v4 — для облачных (YandexGPT), дословное копирование
PROMPT_VERSION=v1

# LLM timeout in seconds
LLM_TIMEOUT_SECONDS=120.0

# Tesseract path (Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Flask settings
FLASK_SECRET_KEY=change_me_in_production
FLASK_DEBUG=false
# OCR: tesseract | easyocr | yandex; доп. проходы OCR для поиска чисел (только tesseract)
OCR_BACKEND=tesseract
OCR_EXTRA_PASSES=true

# LibreOffice для .doc (пусто = автопоиск soffice)
LIBREOFFICE_PATH=

# Yandex Cloud AI Studio (LLM_PROVIDER=yandex и/или OCR_BACKEND=yandex)
# API-ключ сервисного аккаунта с ролями ai.languageModels.user и ai.vision.user
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest
YANDEX_OCR_MODEL=page
# false — Yandex не сохраняет данные запросов
YANDEX_DATA_LOGGING=false

# PDF с текстом меньше этого числа символов на страницу считается сканом (идёт в OCR)
OCR_MIN_CHARS_PER_PAGE=200
