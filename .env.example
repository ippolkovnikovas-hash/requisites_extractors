# LLM Provider: ollama | mock
# Только локальные провайдеры. Внешние LLM-сервисы в проекте запрещены.
LLM_PROVIDER=ollama

# Ollama — локальный endpoint (если LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Версия промпта: v1 | v2 | v3
PROMPT_VERSION=v1

# Таймаут запроса к LLM, секунды
LLM_TIMEOUT_SECONDS=120.0

# Путь к Tesseract (Windows). Пусто — берётся из PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Путь к Poppler (Windows). Пусто — берётся из PATH.
POPPLER_PATH=

# OCR backend: tesseract | easyocr
OCR_BACKEND=tesseract

# Сохранять ли результаты обработки на диск (processed/ и exports/).
# По умолчанию выключено: реквизиты не должны переживать обработку.
# CLI и пакетная обработка включают сохранение самостоятельно.
PERSIST_ARTIFACTS=false

# Flask
FLASK_SECRET_KEY=change_me_in_production
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
