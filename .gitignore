# Python
__pycache__/
**/__pycache__
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# Секреты
.env

# IDE
.idea/
.vscode/
*.iml

# Кэши инструментов
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Рабочие папки: реальные документы и результаты обработки в Git не хранятся
uploads/
processed/
exports/*
!exports/.gitkeep
storage/*
!storage/.gitkeep
logs/*.log

# Документы.
# Реальные загруженные документы и сгенерированные результаты в Git не попадают,
# поэтому .docx/.pdf игнорируются по умолчанию. Исключения — только шаблон
# договора и синтетические тестовые фикстуры (выдуманные реквизиты).
*.docx
*.pdf
!shablon.docx
!tests/fixtures/*.docx
!tests/fixtures/*.pdf

# OS
.DS_Store
Thumbs.db

# Build / dist
dist/
build/
*.egg-info/
